# Configurações Gerais e Render
PORT=3850
NODE_ENV=production

# Banco Principal (Neon PostgreSQL)
# Exemplo: postgresql://usuario:senha@ep-seu-host.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Cache, Filas e Locks (Upstash Redis)
# Exemplo: rediss://default:senha@seu-host.upstash.io:6379
REDIS_URL=

# Credenciais Oficiais Shopee Brasil (também podem ser configuradas no painel)
SHOPEE_APP_ID=
SHOPEE_SECRET_KEY=
DEFAULT_SUB_ID=

# Segurança (gere valores aleatórios longos para produção)
# SESSION_ENCRYPTION_KEY: mínimo 32 caracteres aleatórios para criptografar sessão WhatsApp e Secret Shopee no banco
SESSION_ENCRYPTION_KEY=

# ADMIN_PASSWORD_HASH: gerado com "npm run hash-password -- 'SuaSenhaForte'"
# Se ficar vazio no primeiro boot, o sistema gera uma senha provisória segura em runtime e exige troca no primeiro login
ADMIN_PASSWORD_HASH=

# Segredo compartilhado entre o Render e o Cloudflare Worker para GET /api/ping
PING_SECRET=

# Parâmetros Opcionais de Operação Conservadora
# REDIS_PREFIX=shopee_afiliados:
# SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql
# MIN_DELAY_SECONDS=15
# MAX_DELAY_SECONDS=45
# MAX_SENDS_PER_MINUTE=3
# HUNTER_DEFAULT_INTERVAL_MINUTES=60
# LOG_LEVEL=INFO
